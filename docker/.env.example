# Copy and adjust before use. Set the one that matches what you have.

# Reading a bundle — the usual case. Point at the bundle directory, the
# one holding manifest.json, as the container sees it.
BIOFILTER_BUNDLE=/bundle

# Writing — only for the ETL or `bundle plan`. Not needed to run reports.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/biofilter_dev
